<odoo>
    <record id="ir_cron_primetech_whatsapp_scheduled_messages" model="ir.cron">
        <field name="name">WhatsApp : envoyer les messages planifiés</field>
        <field name="model_id" ref="model_primetech_whatsapp_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_scheduled_messages()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>
