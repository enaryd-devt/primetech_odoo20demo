<odoo>
 <record id="primetech_whatsapp_conversation_view_list" model="ir.ui.view"><field name="name">primetech.whatsapp.conversation.list</field><field name="model">primetech.whatsapp.conversation</field><field name="arch" type="xml"><list><field name="name"/><field name="phone"/><field name="account_id"/><field name="last_message_at"/></list></field></record>
 <record id="primetech_whatsapp_conversation_view_form" model="ir.ui.view"><field name="name">primetech.whatsapp.conversation.form</field><field name="model">primetech.whatsapp.conversation</field><field name="arch" type="xml"><form><header><button name="action_new_message" type="object" string="Envoyer un message" class="btn-primary"/><button name="action_open_send_document" type="object" string="Envoyer devis / commande / facture / BL"/></header><sheet><group><field name="partner_id"/><field name="phone"/><field name="account_id"/><field name="last_message_at" readonly="1"/></group><field name="message_ids" nolabel="1" readonly="1"><list><field name="date"/><field name="direction"/><field name="message_type"/><field name="body"/><field name="attachment_id"/><field name="state"/><field name="error_message"/></list></field></sheet><chatter/></form></field></record>
 <record id="primetech_whatsapp_conversation_action" model="ir.actions.act_window"><field name="name">Conversations</field><field name="res_model">primetech.whatsapp.conversation</field><field name="view_mode">list,form</field></record>
 <record id="primetech_whatsapp_message_view_form" model="ir.ui.view"><field name="name">primetech.whatsapp.message.form</field><field name="model">primetech.whatsapp.message</field><field name="arch" type="xml"><form><header><button name="action_send_now" type="object" string="Envoyer maintenant" class="btn-primary" invisible="direction != 'outgoing'"/><button name="action_schedule" type="object" string="Planifier" invisible="direction != 'outgoing'"/></header><sheet><group><field name="conversation_id"/><field name="direction"/><field name="message_type"/><field name="scheduled_at"/><field name="body"/><field name="attachment_id"/><field name="related_document"/><field name="state" readonly="1"/><field name="error_message" readonly="1"/></group></sheet></form></field></record>
</odoo>
