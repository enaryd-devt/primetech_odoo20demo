<odoo>
 <record id="primetech_whatsapp_campaign_view_list" model="ir.ui.view"><field name="name">primetech.whatsapp.campaign.list</field><field name="model">primetech.whatsapp.campaign</field><field name="arch" type="xml"><list><field name="name"/><field name="account_id"/><field name="scheduled_at"/><field name="state"/></list></field></record>
