<odoo>
    <!-- En Odoo 20, la portée de privilège crée un unique menu déroulant dans
         les droits de la fiche utilisateur. -->
    <record id="privilege_primetech_whatsapp" model="res.groups.privilege">
        <field name="name">WhatsApp</field>
        <field name="sequence">40</field>
        <field name="placeholder">Aucun accès</field>
        <field name="category_id" ref="base.module_category_productivity"/>
    </record>

    <record id="group_primetech_whatsapp_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="primetech_whatsapp_connect.privilege_primetech_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_primetech_whatsapp_manager" model="res.groups">
        <field name="name">Gestionnaire</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="primetech_whatsapp_connect.privilege_primetech_whatsapp"/>
        <field name="implied_ids" eval="[(4, ref('primetech_whatsapp_connect.group_primetech_whatsapp_user'))]"/>
    </record>
</odoo>
